{
  "name": "aoe-agent",
  "version": "0.0.1",
  "description": "Multi-provider ACP agent for the Agent of Empires structured view. Wraps Vercel AI SDK 7 in an ACP server.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "aoe-agent": "src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test test/*.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "ai": "^7.0.77",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
