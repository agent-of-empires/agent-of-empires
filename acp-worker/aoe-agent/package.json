{
  "name": "aoe-agent",
  "version": "0.0.1",
  "description": "Multi-provider ACP agent for the Agent of Empires structured view. Wraps Vercel AI SDK 7 in an ACP server.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "aoe-agent": "src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test test/*.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "ai": "^7.0.99",
    "zod": "^4.5.4"
  },
  "license": "MIT"
}
