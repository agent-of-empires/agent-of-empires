{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoe.invalid/schemas/cli-read/v151/hello.schema.json",
  "title": "cli-read v151 Hello data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "runtime_epoch",
    "prebind_instance_id",
    "namespace",
    "owner",
    "local_owner",
    "health",
    "profiles",
    "status_freshness",
    "runtime_instance_id"
  ],
  "properties": {
    "protocol_version": { "const": 4 },
    "runtime_epoch": { "$ref": "#/$defs/uuid" },
    "prebind_instance_id": { "$ref": "#/$defs/uuid" },
    "runtime_instance_id": { "$ref": "#/$defs/uuid" },
    "namespace": { "$ref": "#/$defs/namespace" },
    "owner": { "$ref": "#/$defs/owner" },
    "local_owner": { "type": "boolean" },
    "health": { "$ref": "#/$defs/aggregate_health" },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile_hello" } },
    "status_freshness": { "$ref": "#/$defs/status_freshness" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "namespace": { "type": "string", "pattern": "^(debug|release):[a-z0-9._-]{1,200}$" },
    "timestamp": {
      "description": "Grammar owned by the code, not by this document: `display_timestamp` in src/cli/list.rs emits chrono SecondsFormat::AutoSi in UTC with a `Z` zone, which is 0, 3, 6 or 9 fractional digits, and `valid_timestamp` in src/cli/runtime_read/dto.rs admits exactly those, a whole second included. Any other fractional width, a numeric offset, lowercase separators, a control character and a missing `Z` are refused; change this pattern only with those two functions.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.([0-9]{3}|[0-9]{6}|[0-9]{9}))?Z$"
    },
    "profile_label": { "type": "string", "minLength": 1 },
    "profile_alias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": { "enum": [".", "..", "all", "All", "aLl", "alL", "ALl", "AlL", "aLL", "ALL"] }
    },
    "health_code": {
      "type": "string",
      "enum": ["enumeration", "profile_enumeration", "metadata"]
    },
    "aggregate_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["healthy", "degraded"] },
        "code": { "$ref": "#/$defs/health_code" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "healthy" } },
          "required": ["kind"],
          "not": { "required": ["code"] }
        },
        {
          "properties": { "kind": { "const": "degraded" } },
          "required": ["kind", "code"]
        }
      ]
    },
    "component_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["healthy", "degraded"] },
        "code": { "$ref": "#/$defs/health_code" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "healthy" } },
          "required": ["kind"],
          "not": { "required": ["code"] }
        },
        {
          "properties": { "kind": { "const": "degraded" } },
          "required": ["kind", "code"]
        }
      ]
    },
    "profile_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_enumeration", "metadata", "profile_data"],
      "properties": {
        "profile_enumeration": { "$ref": "#/$defs/component_health" },
        "metadata": { "$ref": "#/$defs/component_health" },
        "profile_data": { "$ref": "#/$defs/component_health" }
      }
    },
    "status_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "observed_at"],
      "properties": {
        "kind": { "type": "string", "enum": ["unobserved", "observed", "unavailable"] },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "observed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "unobserved" },
            "revision": { "const": 0 },
            "observed_at": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "observed" },
            "revision": { "type": "integer", "minimum": 1 },
            "observed_at": { "$ref": "#/$defs/timestamp" }
          }
        },
        {
          "properties": {
            "kind": { "const": "unavailable" },
            "revision": { "type": "null" },
            "observed_at": { "type": "null" }
          }
        }
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uid"],
      "properties": {
        "kind": { "type": "string", "enum": ["local_owner", "remote"] },
        "uid": { "type": ["integer", "null"], "minimum": 0 }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "local_owner" },
            "uid": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "properties": { "kind": { "const": "remote" }, "uid": { "type": "null" } }
        }
      ]
    },
    "profile_hello": {
      "description": "Selectable physical profile, aliases, local enumeration membership and load health.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "listed", "aliases", "health"],
      "properties": {
        "name": { "$ref": "#/$defs/profile_label" },
        "listed": { "type": "boolean" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/profile_alias" } },
        "health": { "$ref": "#/$defs/profile_health" }
      },
      "oneOf": [
        { "properties": { "listed": { "const": true } } },
        { "properties": { "listed": { "const": false }, "name": { "$ref": "#/$defs/profile_alias" } } }
      ]
    }
  }
}
