{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoe.invalid/schemas/cli-read/v151/expected.schema.json",
  "title": "cli-read v151 per-case expected result metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_revision",
    "case_id",
    "phase",
    "code",
    "exit",
    "stdout_sha256",
    "stderr_sha256",
    "wire_frames"
  ],
  "properties": {
    "artifact_revision": { "const": "v151" },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "parser",
        "handshake",
        "pre_transport",
        "transport",
        "snapshot",
        "semantic",
        "close",
        "renderer"
      ]
    },
    "code": {
      "oneOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }]
    },
    "exit": { "type": "integer", "enum": [0, 1, 2, 4] },
    "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wire_frames": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "code": {
      "type": "string",
      "enum": [
        "parser_error",
        "identifier_required",
        "schema_invalid",
        "invalid_endpoint",
        "invalid_token",
        "establishment_timeout",
        "marker_missing",
        "marker_invalid",
        "marker_identity",
        "anchored_alias_unavailable",
        "unauthorized",
        "unavailable",
        "socket_identity",
        "peer_identity",
        "protocol_mismatch",
        "frame_limit",
        "connection_closed",
        "health_degraded",
        "freshness_unavailable",
        "default_missing",
        "profile_missing",
        "session_missing",
        "session_ambiguous",
        "close_timeout",
        "renderer_internal"
      ]
    }
  }
}
