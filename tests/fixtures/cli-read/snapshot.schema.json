{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoe.invalid/schemas/cli-read/v151/snapshot.schema.json",
  "title": "cli-read v151 Snapshot data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "cursor",
    "health",
    "default_profile",
    "resolved_default_profile",
    "profiles",
    "sessions",
    "global_projects",
    "status_freshness"
  ],
  "properties": {
    "namespace": { "$ref": "#/$defs/namespace" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "health": { "$ref": "#/$defs/snapshot_health" },
    "default_profile": {
      "description": "Names a profile this snapshot carries, or names nothing. The client holds the producer to exactly that and refuses any other value as `schema_invalid`. A resolved name this snapshot does not carry is therefore not spelled here; it is spelled in `resolved_default_profile`.",
      "oneOf": [{ "$ref": "#/$defs/profile_label" }, { "type": "null" }]
    },
    "resolved_default_profile": {
      "description": "What the daemon resolved as the default, published whether or not `default_profile` resolves. A client that has to refuse can therefore name the profile the user has to create rather than saying only that no default exists, which is what the local resolver's own sentence needs. Absent only when resolving would have created a profile, because a read must not write to the store.",
      "oneOf": [{ "$ref": "#/$defs/profile_label" }, { "type": "null" }]
    },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile_read" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session_read" } },
    "global_projects": { "type": "array", "items": { "$ref": "#/$defs/project_read" } },
    "status_freshness": { "$ref": "#/$defs/status_freshness" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "namespace": { "type": "string", "pattern": "^(debug|release):[a-z0-9._-]{1,200}$" },
    "timestamp": {
      "description": "Grammar owned by the code, not by this document: `display_timestamp` in src/cli/list.rs emits chrono SecondsFormat::AutoSi in UTC with a `Z` zone, which is 0, 3, 6 or 9 fractional digits, and `valid_timestamp` in src/cli/runtime_read/dto.rs admits exactly those, a whole second included. Any other fractional width, a numeric offset, lowercase separators, a control character and a missing `Z` are refused; change this pattern only with those two functions.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.([0-9]{3}|[0-9]{6}|[0-9]{9}))?Z$"
    },
    "safe_text": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "profile_label": { "type": "string", "minLength": 1 },
    "profile_alias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": { "enum": [".", "..", "all", "All", "aLl", "alL", "ALl", "AlL", "aLL", "ALL"] }
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/([^/\\u0000]+(/[^/\\u0000]+)*)?$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "stored_project_path": {
      "description": "Stored absolute spelling, preserved verbatim, including legacy dot components and repeated separators.",
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "session_project_path": {
      "oneOf": [{ "$ref": "#/$defs/stored_project_path" }, { "const": "" }]
    },
    "group_path": {
      "type": "string",
      "description": "Opaque stored group key, not a filesystem path."
    },
    "health_code": {
      "type": "string",
      "enum": ["enumeration", "profile_enumeration", "metadata"]
    },
    "component_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["healthy", "degraded"] },
        "code": { "$ref": "#/$defs/health_code" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "healthy" } },
          "required": ["kind"],
          "not": { "required": ["code"] }
        },
        {
          "properties": { "kind": { "const": "degraded" } },
          "required": ["kind", "code"]
        }
      ]
    },
    "profile_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_enumeration", "metadata", "profile_data"],
      "properties": {
        "profile_enumeration": { "$ref": "#/$defs/component_health" },
        "metadata": { "$ref": "#/$defs/component_health" },
        "profile_data": { "$ref": "#/$defs/component_health" }
      }
    },
    "snapshot_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_enumeration", "global_metadata", "profiles"],
      "properties": {
        "global_enumeration": { "$ref": "#/$defs/component_health" },
        "global_metadata": { "$ref": "#/$defs/component_health" },
        "profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/profile_health" }
        }
      }
    },
    "status_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "observed_at"],
      "properties": {
        "kind": { "type": "string", "enum": ["unobserved", "observed", "unavailable"] },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "observed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "unobserved" },
            "revision": { "const": 0 },
            "observed_at": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "observed" },
            "revision": { "type": "integer", "minimum": 1 },
            "observed_at": { "$ref": "#/$defs/timestamp" }
          }
        },
        {
          "properties": {
            "kind": { "const": "unavailable" },
            "revision": { "type": "null" },
            "observed_at": { "type": "null" }
          }
        }
      ]
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "revision"],
      "properties": {
        "epoch": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "group_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "children"],
      "properties": {
        "name": { "type": "string" },
        "path": { "$ref": "#/$defs/group_path" },
        "children": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "merge_key", "scope", "default_base_branch", "registered"],
      "properties": {
        "name": { "type": "string" },
        "path": { "$ref": "#/$defs/session_project_path" },
        "merge_key": { "type": "string", "description": "Canonical registry equality key, or the synthesized stored session path." },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "type": "string", "enum": ["global", "profile"] } }
        },
        "default_base_branch": {
          "type": ["string", "null"]
        },
        "registered": {
          "description": "Required identity flag; synthesized rows exist only in their sessions' profile.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "registered": { "const": true } } },
          "then": { "properties": { "path": { "$ref": "#/$defs/stored_project_path" } } }
        },
        {
          "if": { "properties": { "merge_key": { "const": "" } } },
          "then": { "properties": { "registered": { "const": false }, "path": { "const": "" } } }
        }
      ]
    },
    "profile_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "listed", "aliases", "groups", "projects", "health"],
      "properties": {
        "name": { "$ref": "#/$defs/profile_label" },
        "listed": { "type": "boolean" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/profile_alias" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group_read" } },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project_read" } },
        "health": { "$ref": "#/$defs/profile_health" }
      },
      "oneOf": [
        { "properties": { "listed": { "const": true } } },
        { "properties": { "listed": { "const": false }, "name": { "$ref": "#/$defs/profile_alias" } } }
      ]
    },
    "worktree_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "main_repo_path", "managed_by_aoe", "base_branch"],
      "properties": {
        "branch": { "type": "string" },
        "main_repo_path": { "$ref": "#/$defs/stored_project_path" },
        "managed_by_aoe": { "type": "boolean" },
        "base_branch": { "type": ["string", "null"] }
      }
    },
    "workspace_repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_path", "branch"],
      "properties": {
        "name": { "type": "string" },
        "source_path": { "$ref": "#/$defs/absolute_path" },
        "branch": { "type": "string" }
      }
    },
    "runtime_evidence": {
      "description": "RuntimeEvidence in src/session/instance/status.rs. ACP transport readiness and closure describe the channel, not native OS-process liveness or authority to retry.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["unknown", "pane_alive", "acp_transport_closed", "acp_transport_ready"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pane_exited"],
          "properties": {
            "pane_exited": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exit_code": {
                  "type": ["integer", "null"],
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            }
          }
        }
      ]
    },
    "error_evidence_generation": {
      "description": "ErrorEvidenceGeneration in src/session/instance/status.rs. Terminal lifecycle generations and ACP worker epochs are distinct namespaces.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["terminal_lifecycle"],
          "properties": {
            "terminal_lifecycle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["acp_worker"],
          "properties": {
            "acp_worker": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    },
    "operation_error_evidence": {
      "description": "OperationErrorEvidence in src/session/instance/status.rs. Missing metadata is unknown; absent or null retryability never grants retry permission.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "operation", "observed_at_ms"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["terminal_text", "tmux_observation", "local_prompt_result", "runner_completion", "transcript_recovery"]
        },
        "operation": {
          "type": "string",
          "enum": ["prompt", "context_reset", "terminal_observation"]
        },
        "runtime": {
          "$ref": "#/$defs/runtime_evidence",
          "default": "unknown"
        },
        "origin": {
          "enum": ["tmux_observation", "acp_transport", null]
        },
        "blocking_scope": {
          "enum": ["operation", "runtime", null]
        },
        "retryable": { "type": ["boolean", "null"] },
        "reported_code": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "generation": {
          "oneOf": [{ "$ref": "#/$defs/error_evidence_generation" }, { "type": "null" }]
        }
      }
    },
    "recovery_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attach", "retry_operation", "restart_same", "stop", "fresh"],
      "properties": {
        "attach": { "type": "boolean" },
        "retry_operation": { "type": "boolean" },
        "restart_same": { "type": "boolean" },
        "stop": { "type": "boolean" },
        "fresh": { "type": "boolean" }
      }
    },
    "session_recovery": {
      "description": "SessionRecovery in src/session/projection.rs. This optional read projection is ephemeral; missing projection or metadata is unknown, and explicit null clears the projection.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "diagnostic", "runtime", "work_in_progress", "guidance", "actions", "expected"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["operation_failed", "channel_unavailable", "probe_failed", "identity_unattested", "runtime_exited", "observation_unknown"]
        },
        "diagnostic": { "type": "string" },
        "evidence": {
          "oneOf": [{ "$ref": "#/$defs/operation_error_evidence" }, { "type": "null" }]
        },
        "runtime": { "$ref": "#/$defs/runtime_evidence" },
        "work_in_progress": { "type": "boolean" },
        "uncertainty": { "type": ["string", "null"] },
        "guidance": { "type": "string" },
        "actions": { "$ref": "#/$defs/recovery_actions" },
        "expected": {
          "description": "Opaque server-issued concurrency selection token, not Native authority. May be empty when observation is unavailable and all writes are refused.",
          "type": "string"
        }
      }
    },
    "session_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "project_path",
        "group_path",
        "tool",
        "command",
        "profile",
        "status",
        "state",
        "created_at",
        "last_accessed_at",
        "idle_entered_at",
        "last_error",
        "archived_at",
        "trashed_at",
        "active_snoozed_until",
        "pinned_at",
        "agent_session_id",
        "parent_session_id",
        "has_worktree_info",
        "has_managed_worktree",
        "worktree",
        "workspace_repos"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/safe_text" },
        "title": { "type": "string", "description": "Persisted display text, including empty titles and controls, is preserved as on local reads." },
        "project_path": { "$ref": "#/$defs/session_project_path" },
        "group_path": { "$ref": "#/$defs/group_path" },
        "tool": { "type": "string" },
        "command": { "type": "string" },
        "profile": { "$ref": "#/$defs/profile_label" },
        "status": {
          "type": "string",
          "enum": [
            "Running",
            "Waiting",
            "Idle",
            "Unknown",
            "Stopped",
            "Error",
            "Starting",
            "Deleting",
            "Creating"
          ]
        },
        "state": { "type": "string", "enum": ["live", "archived", "trashed"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "last_accessed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "idle_entered_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "last_error": {
          "type": ["string", "null"]
        },
        "last_error_evidence": {
          "oneOf": [{ "$ref": "#/$defs/operation_error_evidence" }, { "type": "null" }]
        },
        "recovery": {
          "oneOf": [{ "$ref": "#/$defs/session_recovery" }, { "type": "null" }]
        },
        "archived_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "trashed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "active_snoozed_until": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "pinned_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "agent_session_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_text" }, { "type": "null" }]
        },
        "parent_session_id": {
          "oneOf": [{ "$ref": "#/$defs/safe_text" }, { "type": "null" }]
        },
        "has_worktree_info": { "type": "boolean" },
        "has_managed_worktree": { "type": "boolean" },
        "worktree": {
          "oneOf": [{ "$ref": "#/$defs/worktree_read" }, { "type": "null" }]
        },
        "workspace_repos": { "type": "array", "items": { "$ref": "#/$defs/workspace_repo" } }
      }
    }
  }
}
